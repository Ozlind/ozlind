# =========================
# OZLIND — AI PROVIDERS
# =========================
# Optional Vercel AI Gateway layer. When configured, OZLIND can route
# to the selected gateway models first and fall back to direct providers.
AI_GATEWAY_API_KEY=
AI_GATEWAY_FAST_MODEL=
AI_GATEWAY_PRO_MODEL=
AI_GATEWAY_VISION_MODEL=

GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_PRO_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
# Use a Gemini model name that exists in Google AI Studio for your key.
GEMINI_MODEL=
# Embedding model for document search (Stage 5). Must return 768 dimensions.
EMBEDDING_MODEL=

# =========================
# WEB RESEARCH (optional)
# =========================
TAVILY_API_KEY=

# =========================
# SUPABASE
# =========================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# =========================
# SITE
# =========================
# Public address, used for share links and the sitemap (Stage 1-2).
SITE_URL=https://ozlind.vercel.app

# =========================
# OPTIONAL (leave empty until the stage that needs it)
# =========================
# Error tracking (Stage 1)
SENTRY_DSN=
# Bot protection on login (Stage 6)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=