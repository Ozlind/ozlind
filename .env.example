# =========================================================
# OZLIND AI: Environment Variables
# Never commit real keys. Never use NEXT_PUBLIC_* for secrets.
# =========================================================

# --- Supabase ---------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Groq (fast, low-latency chat) ------------------------
GROQ_API_KEY=
# Used by Fast mode (and Auto for short prompts)
GROQ_MODEL_FAST=
# Used as the Groq fallback for Pro mode
GROQ_MODEL_PRO=
# Legacy single-model variable: still honoured if the above are empty
GROQ_MODEL=

# --- Gemini (reasoning + vision) --------------------------
GEMINI_API_KEY=
# Used by Pro mode (deep reasoning)
GEMINI_MODEL_PRO=
# Used as the Gemini fallback for Fast/Auto
GEMINI_MODEL_FAST=
# Must be an image-capable model; used by Vision mode and any image upload
GEMINI_MODEL_VISION=
# Legacy single-model variable: still honoured if the above are empty
GEMINI_TEXT_MODEL=

# --- Experiential Labs (optional extra fallback) ----------
EXPERIENTIAL_API_KEY=
EXPERIENTIAL_MODEL=

# --- Tavily (web research) --------------------------------
TAVILY_API_KEY=