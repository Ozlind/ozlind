# Public Supabase configuration. Safe for browser use.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public PostHog project configuration. These values are intended for browser analytics.
# Set the project key and the matching PostHog ingest host in Vercel and local env.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only credentials and provider configuration. Never expose these in client code.
# PostHog collection is paused unless explicitly enabled with the flag below.
NEXT_PUBLIC_OZLIND_ANALYTICS_ENABLED=false
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_PRO_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional Vercel AI Gateway: routes to supported OpenAI, Anthropic, Google and other models.
# Configure the model IDs you want enabled; these are server-side settings.
AI_GATEWAY_API_KEY=
AI_GATEWAY_FAST_MODEL=
AI_GATEWAY_PRO_MODEL=
AI_GATEWAY_AUTO_MODEL=
AI_GATEWAY_VISION_MODEL=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
TAVILY_API_KEY=
