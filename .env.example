# OZLIND AI — environment variables

# Supabase browser-safe values. These are intentionally public in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side AI provider keys. NEVER use NEXT_PUBLIC_ for these.
GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=

EXPERIENTIAL_API_KEY=
EXPERIENTIAL_MODEL=

TAVILY_API_KEY=

# Optional: only for trusted server-side admin operations.
# SUPABASE_SERVICE_ROLE_KEY=
