<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OZLIND — Visual Identity System</title>
<style>
  :root{
    --bg:#0B0C0E;
    --surface:#151719;
    --surface-2:#1C1F22;
    --surface-3:#25282C;
    --border:#2A2D31;
    --text:#F2F3F4;
    --text-dim:#9AA0A6;
    --text-faint:#5B6066;
    --accent:#C98A52;
    --radius-card:16px;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;
  }
  body{padding:0 0 100px;}
  .wrap{
    max-width:1180px;
    margin:0 auto;
    padding:0 32px;
  }

  svg.oi{
    width:24px;
    height:24px;
    fill:none;
    stroke:currentColor;
    stroke-width:1.75;
    stroke-linecap:round;
    stroke-linejoin:round;
    overflow:visible;
  }

  header.hero{
    padding:88px 0 56px;
    border-bottom:1px solid var(--border);
  }

  .kicker{
    font-size:12px;
    letter-spacing:2px;
    text-transform:uppercase;
    color:var(--accent);
    font-weight:600;
    margin-bottom:22px;
  }

  .hero-mark-row{
    display:flex;
    align-items:center;
    gap:22px;
    margin-bottom:10px;
  }

  .hero-tile{
    width:76px;
    height:76px;
    border-radius:20px;
    background:var(--surface-2);
    border:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .hero-tile svg{
    width:40px;
    height:40px;
    color:var(--text);
  }

  .hero-word{
    font-size:40px;
    font-weight:800;
    letter-spacing:.5px;
  }

  .hero-word .dot{
    color:var(--accent);
  }

  .hero-sub{
    color:var(--text-dim);
    font-size:15px;
    max-width:560px;
    line-height:1.7;
    margin-top:18px;
  }

  section{
    padding:64px 0;
    border-bottom:1px solid var(--border);
  }

  section:last-of-type{
    border-bottom:none;
  }

  h2.section-title{
    font-size:12.5px;
    font-weight:700;
    color:var(--accent);
    text-transform:uppercase;
    letter-spacing:1.8px;
    margin:0 0 8px;
  }

  h3.section-sub{
    font-size:22px;
    font-weight:700;
    margin:0 0 28px;
  }

  p.lede{
    color:var(--text-dim);
    font-size:14.5px;
    line-height:1.75;
    max-width:680px;
    margin:0 0 32px;
  }

  .grid-cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:16px;
  }

  .lcard{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-card);
    padding:28px 20px 18px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    min-height:150px;
    text-align:center;
  }

  .lcard.on-dark{
    background:#000;
  }

  .lcard.on-light{
    background:#EFEFEC;
  }

  .lcard.on-light svg{
    color:#0B0C0E;
  }

  .lcard-label{
    margin-top:14px;
    font-size:12px;
    color:var(--text-dim);
  }

  .lcard-sub{
    font-size:11px;
    color:var(--text-faint);
    margin-top:2px;
  }

  .lockup-h{
    display:flex;
    align-items:center;
    gap:14px;
  }

  .lockup-h svg{
    width:34px;
    height:34px;
    color:var(--text);
  }

  .lockup-h span{
    font-size:21px;
    font-weight:800;
    letter-spacing:.3px;
  }

  .lockup-v{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:10px;
  }

  .lockup-v svg{
    width:36px;
    height:36px;
    color:var(--text);
  }

  .lockup-v span{
    font-size:16px;
    font-weight:800;
    letter-spacing:1.5px;
  }

  .word-accentdot{
    color:var(--accent);
  }

  .size-row{
    display:flex;
    align-items:flex-end;
    gap:22px;
  }

  .size-row .sizeitem{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
  }

  .size-row svg{
    color:var(--text);
  }

  .size-row .sizelabel{
    font-size:10.5px;
    color:var(--text-faint);
  }

  .geo-row{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
    align-items:flex-start;
  }

  .geo-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-card);
    padding:22px;
    flex:1 1 260px;
  }

  .geo-card h4{
    margin:0 0 6px;
    font-size:13.5px;
  }

  .geo-card p{
    margin:0;
    font-size:12.5px;
    color:var(--text-dim);
    line-height:1.65;
  }

  .geo-diagram{
    width:100%;
    height:auto;
    margin-bottom:14px;
  }

  .token-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:14px;
  }

  .swatch{
    border-radius:10px;
    border:1px solid var(--border);
    overflow:hidden;
  }

  .swatch .chip{
    height:58px;
  }

  .swatch .meta{
    padding:10px 12px;
    background:var(--surface);
  }

  .swatch .meta .name{
    font-size:11.5px;
    font-weight:600;
  }

  .swatch .meta .hex{
    font-size:11px;
    color:var(--text-dim);
  }

  .cat-heading{
    font-size:12px;
    font-weight:700;
    color:var(--text-dim);
    text-transform:uppercase;
    letter-spacing:1.2px;
    margin:36px 0 14px;
  }

  .cat-heading:first-of-type{
    margin-top:0;
  }

  .icon-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(104px,1fr));
    gap:10px;
  }

  .icon-tile{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:12px;
    padding:16px 6px 12px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:9px;
    transition:border-color .15s ease,transform .15s ease;
  }

  .icon-tile:hover{
    border-color:var(--accent);
    transform:translateY(-2px);
  }

  .icon-tile .label{
    font-size:10px;
    color:var(--text-dim);
    text-align:center;
    line-height:1.3;
  }

  .sym-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(140px,1fr));
    gap:12px;
  }

  .sym-tile{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:14px;
    padding:22px 12px 16px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:10px;
  }

  .sym-tile svg{
    width:30px;
    height:30px;
  }

  .sym-tile .label{
    font-size:12px;
    font-weight:600;
  }

  .sym-tile .desc{
    font-size:10.5px;
    color:var(--text-faint);
    text-align:center;
    line-height:1.5;
  }

  .source-row{
    display:flex;
    align-items:center;
    gap:8px;
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:14px;
    padding:12px 14px;
    width:fit-content;
  }

  .src-slot{
    width:30px;
    height:30px;
    border-radius:9px;
    background:var(--surface-3);
    border:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:9.5px;
    font-weight:700;
    color:var(--text-dim);
    letter-spacing:.2px;
  }

  .src-overflow{
    width:30px;
    height:30px;
    border-radius:9px;
    background:var(--surface-2);
    border:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:10.5px;
    font-weight:700;
    color:var(--text);
  }

  .src-note{
    font-size:12px;
    color:var(--text-dim);
    margin-top:14px;
    line-height:1.7;
    max-width:640px;
  }

  .src-expand{
    margin-top:22px;
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:14px;
    padding:16px 18px;
    width:fit-content;
    display:flex;
    align-items:center;
    gap:14px;
  }

  .src-expand .src-slot{
    width:36px;
    height:36px;
    border-radius:10px;
  }

  .src-expand-meta .title{
    font-size:13px;
    font-weight:600;
  }

  .src-expand-meta .domain{
    font-size:11.5px;
    color:var(--text-dim);
    margin-top:2px;
  }

  .src-expand svg.openicon{
    width:16px;
    height:16px;
    color:var(--text-faint);
    margin-left:8px;
  }

  .fallback-row{
    display:flex;
    align-items:center;
    gap:14px;
    margin-top:22px;
  }

  .fallback-row .src-slot{
    width:36px;
    height:36px;
    border-radius:10px;
  }

  .fallback-row .src-slot svg{
    width:18px;
    height:18px;
    color:var(--text-dim);
  }

  table.naming{
    width:100%;
    border-collapse:collapse;
    font-size:12.5px;
  }

  table.naming th,
  table.naming td{
    text-align:left;
    padding:10px 14px;
    border-bottom:1px solid var(--border);
  }

  table.naming th{
    color:var(--text-dim);
    font-weight:600;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.8px;
  }

  table.naming td code{
    background:var(--surface-2);
    padding:2px 7px;
    border-radius:5px;
    font-size:11.5px;
  }

  ul.rules{
    margin:0;
    padding-left:20px;
    color:var(--text-dim);
    font-size:13px;
    line-height:2;
  }

  .dodont{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
  }

  .dodont .col h4{
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:1px;
    margin:0 0 10px;
  }

  .dodont .col.do h4{
    color:#8FD19E;
  }

  .dodont .col.dont h4{
    color:#E28B8B;
  }

  .dodont ul{
    margin:0;
    padding-left:18px;
    font-size:13px;
    color:var(--text-dim);
    line-height:1.9;
  }

  .code-box{
    background:#000;
    border:1px solid var(--border);
    border-radius:12px;
    padding:18px 20px;
    overflow-x:auto;
    font-family:'Consolas','Courier New',monospace;
    font-size:12px;
    line-height:1.7;
    color:#D9C7B0;
    white-space:pre;
    margin-top:14px;
  }

  footer{
    padding-top:44px;
    font-size:12px;
    color:var(--text-faint);
  }

  @media(max-width:700px){
    .wrap{
      padding:0 18px;
    }

    header.hero{
      padding:56px 0 40px;
    }

    .hero-mark-row{
      gap:14px;
    }

    .hero-tile{
      width:62px;
      height:62px;
      border-radius:16px;
    }

    .hero-tile svg{
      width:34px;
      height:34px;
    }

    .hero-word{
      font-size:30px;
    }

    section{
      padding:44px 0;
    }

    h3.section-sub{
      font-size:20px;
    }

    .size-row{
      gap:12px;
    }

    .dodont{
      grid-template-columns:1fr;
    }

    .source-row,
    .src-expand{
      width:100%;
    }

    .src-expand{
      gap:10px;
    }

    .src-expand-meta{
      min-width:0;
    }

    .src-expand-meta .title{
      overflow-wrap:anywhere;
    }

    table.naming{
      display:block;
      overflow-x:auto;
      white-space:nowrap;
    }

    .icon-grid{
      grid-template-columns:repeat(3,minmax(0,1fr));
    }

    .sym-grid{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }
  }
</style>
</head>

<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
<defs>

  <symbol id="ozl-mark" viewBox="0 0 96 96">
    <path d="M78.07 37.06 A32 32 0 1 1 58.94 17.93 L78.55 17.45 Z" fill="currentColor"/>
    <circle cx="84.2" cy="11.8" r="4.6" fill="var(--dot-color, currentColor)"/>
  </symbol>

  <symbol id="ozl-node" viewBox="0 0 10 10">
    <circle cx="5" cy="5" r="5" fill="currentColor"/>
  </symbol>

  <symbol id="sym-insight" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"/>
    <circle cx="16.6" cy="7.6" r="1.6" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="sym-research" viewBox="0 0 24 24">
    <circle cx="10" cy="10" r="6.5"/>
    <path d="M14.6 14.6 19 19"/>
    <path d="M9 2.6a8 8 0 0 1 7.2 4.4" stroke-width="1.4" opacity=".6"/>
  </symbol>

  <symbol id="sym-discovery" viewBox="0 0 24 24">
    <circle cx="10" cy="13" r="7"/>
    <path d="M16.2 8.6 18 7.4"/>
    <circle cx="19.3" cy="6.6" r="1.6" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="sym-creation" viewBox="0 0 24 24">
    <path d="M20.46 8.92 19.96 4.04 15.08 3.54Z" fill="currentColor" stroke="none"/>
    <circle cx="21.23" cy="2.77" r="1.4" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="sym-conversation" viewBox="0 0 24 24">
    <circle cx="9" cy="12" r="6.5"/>
    <circle cx="16" cy="12" r="6.5"/>
  </symbol>

  <symbol id="sym-sources" viewBox="0 0 24 24">
    <circle cx="12" cy="13" r="7"/>
    <path d="M8 5.5 8.8 7.2M12 4.3v2M16 5.5 15.2 7.2"/>
  </symbol>

  <symbol id="sym-active" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="7.5"/>
    <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="sym-thinking" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"/>
    <circle cx="10" cy="10" r="1.3" fill="currentColor" stroke="none"/>
    <circle cx="14" cy="10" r="1.3" fill="currentColor" stroke="none"/>
    <circle cx="12" cy="14.5" r="1.3" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="sym-processing" viewBox="0 0 24 24">
    <path d="M20 12A8 8 0 1 1 12 4"/>
    <circle cx="20" cy="12" r="1.6" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="sym-success" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"/>
    <path d="M8.3 12.6 11 15.3l5-6.2"/>
  </symbol>

  <symbol id="sym-warning" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"/>
    <path d="M12 8v5.5"/>
    <circle cx="12" cy="16.3" r="1" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="i-ai-chat" viewBox="0 0 24 24">
    <rect x="3.5" y="5.5" width="17" height="11" rx="5"/>
    <path d="M7 10.2h6M7 13.2h9"/>
  </symbol>

  <symbol id="i-home" viewBox="0 0 24 24">
    <path d="M4.5 12 12 5.5 19.5 12"/>
    <path d="M6.5 10.5V19a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-8.5"/>
  </symbol>

  <symbol id="i-new-conversation" viewBox="0 0 24 24">
    <rect x="3.5" y="5.5" width="14" height="10" rx="4"/>
    <path d="M16 17h4M18 15v4"/>
  </symbol>

  <symbol id="i-search" viewBox="0 0 24 24">
    <circle cx="10.5" cy="10.5" r="6.5"/>
    <path d="M15.3 15.3 20 20"/>
  </symbol>

  <symbol id="i-menu" viewBox="0 0 24 24">
    <path d="M4 6.5h16M4 12h12M4 17.5h16"/>
  </symbol>

  <symbol id="i-settings" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="3"/>
    <path d="M12 3.5v2.6M12 17.9v2.6M20.5 12h-2.6M6.1 12H3.5M17.6 6.4l-1.9 1.9M8.3 15.7l-1.9 1.9M17.6 17.6l-1.9-1.9M8.3 8.3 6.4 6.4"/>
  </symbol>

  <symbol id="i-profile" viewBox="0 0 24 24">
    <circle cx="12" cy="8.2" r="3.4"/>
    <path d="M5.5 19.5c1-4 3.6-6 6.5-6s5.5 2 6.5 6"/>
  </symbol>

  <symbol id="i-history" viewBox="0 0 24 24">
    <path d="M5 8A8 8 0 1 1 4.2 13"/>
    <path d="M3 5.5 5 8 2.3 9.3"/>
    <path d="M12 8.5v4l3 2"/>
  </symbol>

  <symbol id="i-back" viewBox="0 0 24 24">
    <path d="M15 5 8.5 12 15 19"/>
  </symbol>

  <symbol id="i-forward" viewBox="0 0 24 24">
    <path d="M9 5 15.5 12 9 19"/>
  </symbol>

  <symbol id="i-close" viewBox="0 0 24 24">
    <path d="M5.5 5.5 18.5 18.5M18.5 5.5 5.5 18.5" stroke-width="1.9"/>
  </symbol>

  <symbol id="i-research" viewBox="0 0 24 24">
    <circle cx="10" cy="10" r="6"/>
    <path d="M14.3 14.3 19 19"/>
    <path d="M7.5 10h4.5"/>
  </symbol>

  <symbol id="i-web-research" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"/>
    <path d="M4 12h16"/>
    <path d="M12 4c-3 3-3 13 0 16"/>
  </symbol>

  <symbol id="i-sources" viewBox="0 0 24 24">
    <rect x="4" y="6.5" width="13" height="11" rx="2.5"/>
    <rect x="7" y="3.5" width="13" height="11" rx="2.5" fill="var(--bg,#0B0C0E)"/>
  </symbol>

  <symbol id="i-image-generator" viewBox="0 0 24 24">
    <rect x="3.5" y="4.5" width="17" height="15" rx="3"/>
    <path d="M13.8 12.9 13.4 10.6 11.2 10.2 13.4 9.8 13.8 7.5 14.2 9.8 16.4 10.2 14.2 10.6Z" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="i-photo-editor" viewBox="0 0 24 24">
    <rect x="3.5" y="4.5" width="17" height="15" rx="3"/>
    <path d="M8.3 8.3v9"/>
    <circle cx="8.3" cy="12.8" r="1.7" fill="var(--bg,#0B0C0E)"/>
    <path d="M15.7 8.3v9"/>
    <circle cx="15.7" cy="10.2" r="1.7" fill="var(--bg,#0B0C0E)"/>
  </symbol>

  <symbol id="i-code-assistant" viewBox="0 0 24 24">
    <path d="M9 8 4.5 12 9 16"/>
    <path d="M15 8l4.5 4-4.5 4"/>
  </symbol>

  <symbol id="i-documents" viewBox="0 0 24 24">
    <path d="M7 3.5h7l4 4v12.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"/>
    <path d="M14 3.5v4h4"/>
    <path d="M9 12.5h6M9 15.8h6M9 9.3h3.5"/>
  </symbol>

  <symbol id="i-voice-ai" viewBox="0 0 24 24">
    <rect x="4" y="8.5" width="4" height="7" rx="2"/>
    <path d="M11 16v-9M14 14v-5M17 12v-1.5" stroke-linecap="round"/>
  </symbol>

  <symbol id="i-send" viewBox="0 0 24 24">
    <path d="M4 12 20 4l-4.6 16-4-6.8L4 12Z"/>
    <path d="M11.4 13.2 20 4"/>
  </symbol>

  <symbol id="i-attach" viewBox="0 0 24 24">
    <path d="M15.5 6.5 8.8 13.2a3 3 0 1 0 4.2 4.2l7-7a5 5 0 0 0-7.1-7.1l-7.3 7.3a1.6 1.6 0 0 0 2.3 2.3l6.4-6.4"/>
  </symbol>

  <symbol id="i-microphone" viewBox="0 0 24 24">
    <rect x="9.5" y="3.5" width="5" height="10" rx="2.5"/>
    <path d="M6.5 12a5.5 5.5 0 0 0 11 0"/>
    <path d="M12 17.5v3M9 20.5h6"/>
  </symbol>

  <symbol id="i-stop" viewBox="0 0 24 24">
    <rect x="7" y="7" width="10" height="10" rx="2.5"/>
  </symbol>

  <symbol id="i-error" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"/>
    <path d="M9.3 9.3 14.7 14.7M14.7 9.3 9.3 14.7"/>
  </symbol>

  <symbol id="i-information" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="8"/>
    <circle cx="12" cy="8.3" r="1" fill="currentColor" stroke="none"/>
    <path d="M12 11v5"/>
  </symbol>

  <symbol id="i-copy" viewBox="0 0 24 24">
    <rect x="4" y="8" width="12" height="12" rx="2.5"/>
